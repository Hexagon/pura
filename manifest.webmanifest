{
    "name": "Pura Image Editor",
    "short_name": "Pura",
    "description": "Private, layer-based image editor that runs entirely on your device.",
    "id": "/",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#15151b",
    "theme_color": "#15151b",
    "categories": ["graphics", "photo", "productivity"],
    "icons": [
        { "src": "img/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "img/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "img/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
        { "src": "img/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
    ],
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".tif", ".tiff", ".avif", ".heic", ".apng", ".ico", ".qoi", ".pcx", ".ppm", ".pgm", ".pbm", ".pam", ".dng"]
            }
        }
    ],
    "share_target": {
        "action": "/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": { "files": [{ "name": "images", "accept": ["image/*"] }] }
    }
}
